{
  "cleanUrls": true,
  "regions": ["gru1"],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "escritorio-petiscos-sistema.vercel.app" }], "destination": "/sistema", "permanent": false }
  ],
  "rewrites": [{ "source": "/admin", "destination": "/painel" }],
  "headers": [
    { "source": "/painel", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/sistema", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/garcom", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/caixa", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
